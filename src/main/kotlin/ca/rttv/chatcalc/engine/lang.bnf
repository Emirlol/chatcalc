program ::= statement* EOF


// The language starts with splitting the program into 5 possible statements, merging both parsers from the previous versions:
// - Function definitions
// - Variable assignments
// - Undefine statements (to remove variables or functions)
// - Query statements (expression with = at the end to get evaluated value appended to input)
// - Expressions to be evaluated as is, which is where majority of the language lies
statement ::= function_definition
          | variable_assignment
          | undefine_statement
          | query_statement
          | expression_statement

function_definition ::= IDENTIFIER "(" parameter_list? ")" type_annotation? "=" expression
parameter_list ::= parameter ("," parameter)*
parameter ::= IDENTIFIER type_annotation? // Optional type annotation
type_annotation ::= ":" type_union
type_union ::= type ( "|" type )*
type ::= "number" | "vector" | "function" | "boolean" | "any" // Primitive types. The user can't define new types so this is fine. We can just extend if we add new ones.

variable_assignment ::= IDENTIFIER "=" expression
undefine_statement ::= IDENTIFIER "=" EOF
query_statement ::= expression "=" EOF
expression_statement ::= expression


expression ::= logical_or

logical_or ::= logical_and ( "||" logical_and )*
logical_and ::= equality ( "&&" equality )*
equality ::= comparison ( ( "==" | "!=" | "≠") comparison )*
comparison ::= addition ( ( "<" | "<=" | "≤" | ">" | ">=" | "≥" ) addition )
addition ::= multiplication ( ( "+" | "-" ) multiplication )*
multiplication ::= unary ( ( "*" | "×" | "/" | "%" | ".*" | ".×" | "./" ) unary | implicit_multiplication )*
implicit_multiplication ::= unary
unary ::= ( "-" | "+" | "~" /* logical not */ ) unary | exponentiation
exponentiation ::= postfix ( ( "^" | ".^" ) unary )?
postfix ::= access ( "!" )*
access ::= primary ( call_suffix | index_suffix )* // Function calls and indexing can be chained (e.g., func1()[0](arg1, arg2)) since the return type might be callable or indexable
call_suffix ::= "(" arguments? ")"
index_suffix ::= "[" (arguments | slice) "]" // 0-based indexing
slice ::= ( expression? ":" expression? ) ( ":" expression? )? // start:end:step, all optional
primary ::= NUMBER
          | BOOLEAN_LITERAL
          | lambda_expression
          | IDENTIFIER
          | grouping
          | absolute
          | vector_literal
          | conditional

lambda_expression ::= ( IDENTIFIER | "(" parameter_list? ")" ) ("->" | "→" ) expression // Accepts both `x -> x + 1` and `(x: scalar, y: scalar) -> x * y`, or even `x → x + 1` because why not. I like the arrow.

// There is always a true or false branch since the math language is functional in nature (that we have declared as expressions, statements are required for complete mod functionality and need side effects to do so)
// We always need a return value, so both branches are mandatory
conditional ::= "if" "(" expression "," expression "," expression ")" // if(cond,iftrue,iffalse)

grouping ::= "(" expression ")"
absolute ::= "|" expression "|"

arguments ::= expression ( "," expression )*
vector_literal ::= "[" arguments? "]"

IDENTIFIER ::= "regexp:[a-zA-Z_][a-zA-Z0-9_]*"
NUMBER ::= "regexp:0x[0-9a-fA-F]+|0b[0-1]+|0o[0-7]+|[0-9]+(\.[0-9]+)?"
BOOLEAN_LITERAL ::= "true" | "false"
